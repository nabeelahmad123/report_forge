# Origin allowed to call this API (CORS). Set to the deployed frontend URL in production.
FRONTEND_ORIGIN=http://localhost:5173

LOG_LEVEL=INFO

# Path to the bundled demo dataset used by POST /analyze?use_demo=true.
# Defaults to backend/data/demo_experiment.csv — override only if you relocate it.
# DEMO_DATA_PATH=./data/demo_experiment.csv

# Path to the bundled RegWatch snapshot used by GET /feed.
# Defaults to backend/data/regwatch_snapshot.json — override only if you relocate it.
# REGWATCH_SNAPSHOT_PATH=./data/regwatch_snapshot.json

# Optional: without this, POST /report falls back to a template-generated
# report (no LLM call) — the app still works end-to-end, just without AI prose.
# ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5
REPORT_RATE_LIMIT_PER_MINUTE=10
