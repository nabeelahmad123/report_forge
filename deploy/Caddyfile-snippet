# Append this block to the shared Caddyfile on the droplet
# (/opt/learn-german/Caddyfile) — same file learn-german and procurematch
# already share. Back up the Caddyfile before editing, then:
#   docker exec learn-german-caddy-1 caddy reload --config /etc/caddy/Caddyfile
# to apply without dropping existing connections.

# ReportForge (third project on this droplet, see /opt/reportforge).
# Static Vite SPA at / (reportforge-frontend), FastAPI at /api/*
# (reportforge-backend) — one hostname, path-based routing. Same
# free-DNS pattern as procurematch.duckdns.org above.
reportforge.duckdns.org {
	encode zstd gzip
	handle_path /api/* {
		reverse_proxy reportforge-backend:8000
	}
	handle {
		reverse_proxy reportforge-frontend:80
	}
}
